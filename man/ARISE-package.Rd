\alias{ARISE}
\docType{package}
\title{ARISE: Adaptive Residual-Informed Stability Ensemble Feature Selection}
\description{
The ARISE package provides the Adaptive Residual-Informed Stability Ensemble method for supervised feature selection in biomedical omics.
}
\details{
The package contains one feature selection function, \code{ARISEFS}, and one example dataset, \code{NovartisMultiTissue}. The function returns only the column indices of the selected features.
}
\author{
Zardad Khan, Amjad Ali, Naz Gul, and Saeed Aldahmani
}
\references{
Khan, Zardad, Amjad Ali, Naz Gul, and Saeed Aldahmani (2026).
ARISE: An adaptive residual-informed stability ensemble for feature selection
in small-sample biomedical omics. \emph{arXiv preprint arXiv:2608.14866}.
\doi{10.48550/arXiv.2608.14866}.
}
\seealso{
\code{\link{ARISEFS}}, \code{\link{NovartisMultiTissue}}
}
